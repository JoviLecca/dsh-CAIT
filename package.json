{
  "name": "dsh-cait",
  "version": "1.1.6",
  "license": "Apache-2.0",
  "author": {
    "name": "Jovi Lecca",
    "url": "https://github.com/JoviLecca"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoviLecca/dsh-CAIT.git"
  },
  "homepage": "https://github.com/JoviLecca/dsh-CAIT#readme",
  "bugs": {
    "url": "https://github.com/JoviLecca/dsh-CAIT/issues"
  },
  "description": "CAIT — a CAT workbench for DeepSeek Harness with translation memory, glossary, document tabs, MT routes, and Office/EPUB/subtitle/localization formats.",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cat",
    "translation",
    "translation-memory",
    "glossary",
    "docx",
    "xlsx",
    "pptx",
    "xliff"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "node scripts/build-client.mjs && node --check client.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client",
    "scripts",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
