{
  "name": "dsh-cait",
  "version": "1.1.8-beta1",
  "license": "Apache-2.0",
  "author": {
    "name": "Jovi Lecca",
    "url": "https://github.com/JoviLecca"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoviLecca/dsh-CAIT.git"
  },
  "homepage": "https://github.com/JoviLecca/dsh-CAIT#readme",
  "bugs": {
    "url": "https://github.com/JoviLecca/dsh-CAIT/issues"
  },
  "description": "CAIT 鈥?a CAT workbench for DeepSeek Harness with translation memory, glossary, document tabs, MT routes, and Office/EPUB/subtitle/localization formats.",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cat",
    "translation",
    "translation-memory",
    "glossary",
    "docx",
    "xlsx",
    "pptx",
    "xliff"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check": "npm run lint && npm run format:check && npm run check:locales && npm run check:store && npm run check:formats && npm run check:shared && npm run check:api && npm run check:client && npm test",
    "check:api": "node scripts/check-api.mjs",
    "check:client": "node scripts/check-client.mjs",
    "check:formats": "node scripts/check-formats.mjs",
    "check:shared": "node scripts/check-shared.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:store": "node scripts/check-store.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint lib index.js scripts _dev client",
    "test": "node scripts/run-tests.mjs",
    "test:one": "node scripts/run-tests.mjs",
    "prepublishOnly": "npm run build:client && npm run check"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client",
    "scripts",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
